---
import Layout from '../layouts/Layout.astro';
import { LIVE_MAP } from '../data/live-map.mjs';
import { supabaseAdmin } from '../lib/supabase';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';
import { TIMES } from '../data/jogo';

export const prerender = false;

// Presença tolera 60 s de cache e evita repetir as consultas em cada visita.
Astro.response.headers.set(
  'cache-control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
);

let online: any[] = [], cities: any[] = [], configured = !!supabaseAdmin;
let totals = { players: 0, matches: 0, kills: 0, mp: 0, mb: 0 };
let teamSource: 'telemetry' | 'legacy' = 'telemetry';
let teamCounts = TIMES.map(t => ({ ...t, code: t.id, matches: 0, pct: 0 }));
if (supabaseAdmin) {
  const { count } = await supabaseAdmin.from('player_points').select('id', { count: 'exact', head: true });
  totals.players = count ?? 0;
  const { data: st } = await supabaseAdmin.from('player_points').select('matches,kills,matches_p,matches_b');
  for(const r of st ?? []) {totals.matches+=r.matches;totals.kills+=r.kills;totals.mp+=r.matches_p;totals.mb+=r.matches_b;}
  const tq = await Promise.all(teamCounts.map(t =>
    supabaseAdmin!.from('match_event').select('*', { count: 'exact', head: true }).eq('faction', t.code),
  ));
  if (tq.some(r => r.error) || !tq.some(r => (r.count ?? 0) > 0)) {
    teamSource = 'legacy';
    teamCounts = teamCounts.map(t => ({ ...t, matches: t.code === 'E' ? totals.mp : totals.mb }));
  } else {
    teamCounts = teamCounts.map((t, i) => ({ ...t, matches: tq[i].count ?? 0 }));
  }
  // Agrega o histórico total e a presença por cidade.
  const { data: cd } = await supabaseAdmin.from('city_daily').select('*');
  const agg = new Map<string, any>();
  for (const r of cd ?? []) {
    const cur = agg.get(r.city) || { city: r.city, country: r.country, matches: 0, rounds: 0, players: new Set<string>(), lat: null, lon: null };
    cur.matches += r.matches; cur.rounds += r.rounds ?? 0; agg.set(r.city, cur);
  }
  cities = [...agg.values()].sort((a, b) => b.matches - a.matches)
    .map(c => ({ ...c, players: [...c.players].sort() }));
}
Astro.response.headers.set('cache-control','no-store');
const teamTotal = teamCounts.reduce((sum, t) => sum + t.matches, 0);
teamCounts = teamCounts.map(t => ({ ...t, pct: teamTotal ? Math.round((t.matches / teamTotal) * 100) : 0 }));
const mapData = { online: online.filter(o => o.lat && o.lon), cities: cities.filter(c => c.lat && c.lon) };
---
<Layout
  title={`Mapa da treta - de onde a comunidade joga | ${BRAND_FULL}`}
  description={LIVE_MAP.description}
  jsonld={[{ '@id': GAME_ID }, { '@type': 'FAQPage', '@id': abs('/mapa') + '#faq', mainEntity: LIVE_MAP.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }, {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Mapa ao vivo', item: abs('/mapa') },
    ],
  }]}
  h1="Mapa da treta"
  kicker="Comunidade · histórico por cidade"
  heroImg="/img/map-previews/quebrada.jpg"
  heroPos="40%">
  <Fragment slot="sub">
    Onde a treta está acontecendo agora, cidade por cidade. A localização é aproximada e no nível
    de cidade - nenhum IP aparece aqui.
  </Fragment>
  <!-- Leaflet 1.9.4 (BSD-2-Clause) vendorizado em public/vendor/leaflet/ - origem:
       https://unpkg.com/leaflet@1.9.4/dist/ . Vendorizado pelo mesmo motivo do
       Three.js: era o ÚNICO host externo em script-src/style-src da CSP, e a
       exceção valia pro site todo, não só pra esta página. Ao atualizar, troque
       os arquivos e a versão aqui. -->
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" slot="head">
  <style slot="head">
    .map-tip{background:rgba(8,12,8,.88)!important;border:1px solid #4a5a2a!important;color:#d8e0b0!important;
      font:10px Consolas,monospace;padding:1px 6px;box-shadow:none!important}
    .map-tip:before{display:none}
    .map-pop .leaflet-popup-content-wrapper{background:#10130c;color:#d8e0b0;border:1px solid #4a5a2a;font-family:Consolas,monospace;font-size:12px}
    .map-pop .leaflet-popup-tip{background:#10130c;border:1px solid #4a5a2a}
    .map-pop a{color:#b8d94a}
  </style>
  {configured && (
    <div class="tstat" aria-label="Histórico registrado">
      <div><b>{totals.players}</b><span>jogadores registrados</span></div>
      <div><b>{totals.matches}</b><span>partidas registradas</span></div>
      <div><b>{totals.kills}</b><span>abates registrados</span></div>
    </div>
  )}
  {configured && (
    <section class="team-stats" aria-labelledby="team-title">
      <div class="team-head">
        <h2 id="team-title">Partidas por time</h2>
        <span>{teamTotal} com time identificado</span>
      </div>
      <div class="team-grid">
        {teamCounts.map(t => (
          <div class="team-row">
            <div><strong style={`color:${t.cor}`}>{t.nome}</strong><span>{t.matches} · {t.pct}%</span></div>
            <span class="team-track"><span style={`width:${t.pct}%;background:${t.cor}`}></span></span>
          </div>
        ))}
      </div>
      <p>{teamSource === 'telemetry'
        ? 'Contagem anônima de partidas registradas, separada do ranking de jogadores.'
        : 'A telemetria recente ainda está indisponível; os números de Time E e Time B vêm do histórico do ranking.'}</p>
    </section>
  )}
  <p>A presença pessoal fica na lista de amigos. Em amarelo, o histórico total de partidas por cidade (localização aproximada, nível cidade - sem IP).</p>
  {/* Presença nominal cobre somente jogadores registrados. */}
  <p style="font-size:12px;color:var(--bone-dim);margin-top:-6px">
    Localização agregada por cidade. A presença de jogadores fica visível somente aos amigos autorizados.
  </p>
  {!configured && <p>Mapa ainda não configurado.</p>}
  <div id="map" style="height:520px;border:1px solid var(--line);background:var(--panel)"></div>
  <script src="/vendor/leaflet/leaflet.js" is:inline></script>
  <script is:inline define:vars={{ mapData }}>
    // Dados do banco precisam ser escapados antes de entrar no HTML do Leaflet.
    const esc = (s) => String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    const map = L.map('map', { scrollWheelZoom: true }).setView([-14.5, -52.5], 4);
    // CARTO sem chave devolve tile "API KEY REQUIRED" e o OSM público bloqueia (403); Esri não exige chave.
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16, attribution: 'Tiles &copy; Esri &mdash; Esri, HERE, Garmin',
    }).addTo(map);
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16,
    }).addTo(map);
    const maxM = Math.max(1, ...mapData.cities.map(c => c.matches));
    for (const c of mapData.cities) {
      const m = L.circleMarker([c.lat, c.lon], {
        radius: 6 + 18 * (c.matches / maxM), color: '#ffd23f', weight: 2,
        fillColor: '#ffd23f', fillOpacity: 0.25,
      }).addTo(map);
      // Tooltip só no hover para não cobrir marcadores próximos.
      m.bindTooltip(`${esc(c.city)} · ${c.matches}`, { direction: 'top', offset: [0, -8], className: 'map-tip' });
      // popup do CLIQUE: cidade, totais e lista de jogadores
      const shown = c.players.slice(0, 12).map(esc), more = c.players.length - shown.length;
      const plist = c.players.length
        ? `<br><b>${c.players.length} jogador${c.players.length > 1 ? 'es' : ''}:</b> ${shown.join(', ')}${more > 0 ? ` +${more}` : ''}`
        : '';
      m.bindPopup(`<b>${esc(c.city)}</b><br>${c.matches} partidas · ${c.rounds} rounds (histórico)${plist}`, { className: 'map-pop' });
    }
    for (const o of mapData.online) {
      L.circleMarker([o.lat, o.lon], {
        radius: 5, color: '#9dff9d', weight: 2, fillColor: '#9dff9d', fillOpacity: 0.9,
      }).addTo(map).bindPopup(`<b>${esc(o.nick)}</b> online agora${o.city ? ' · ' + esc(o.city) : ''}`);
    }
  </script>
  <section aria-labelledby="map-faq-title">
    <h2 id="map-faq-title">Entenda o mapa ao vivo</h2>
    {LIVE_MAP.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </section>
</Layout>

<style>
  .team-stats{margin:18px 0 22px;padding:18px;border:1px solid var(--tp-borda);border-radius:12px;background:var(--panel)}
  .team-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:12px}
  .team-head h2{margin:0;font-size:22px}.team-head>span,.team-stats>p{font:11px var(--mono);color:var(--bone-dim)}
  .team-grid{display:grid;grid-template-columns:repeat(2,minmax(190px,1fr));gap:12px 18px}
  .team-row>div{display:flex;justify-content:space-between;gap:10px;font:12px var(--mono)}.team-row>div span{color:var(--bone-dim)}
  .team-track{display:block;height:8px;margin-top:7px;border-radius:999px;background:#090704;overflow:hidden}
  .team-track>span{display:block;height:100%;min-width:0;border-radius:inherit}.team-stats>p{margin:14px 0 0}
  @media(max-width:600px){.team-grid{grid-template-columns:1fr}}
</style>
