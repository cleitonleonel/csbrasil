---
import Layout from './Layout.astro';
import { LEGAL_CONTACT, LEGAL_OPERATOR, LEGAL_UPDATED } from '../lib/legal';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<Layout title={`${title} | CORO SOLTO`} description={description}>
  <article class="legal-page panel">
    <nav aria-label="Documentos do jogo">
      <a href="/privacidade" aria-current={Astro.url.pathname === '/privacidade' ? 'page' : undefined}>Privacidade</a>
      <a href="/termos" aria-current={Astro.url.pathname === '/termos' ? 'page' : undefined}>Termos de uso</a>
    </nav>
    <h1>{title}</h1>
    <p class="updated">Atualizado em {LEGAL_UPDATED}</p>
    <p><strong>Responsável pelo serviço:</strong> {LEGAL_OPERATOR}. Contato para suporte, privacidade e revisão de decisões: <a href={`mailto:${LEGAL_CONTACT}`}>{LEGAL_CONTACT}</a>.</p>
    <slot />
    <p class="back"><a href="/">VOLTAR AO JOGO ▸</a></p>
  </article>
</Layout>
<style>
  .legal-page { max-width: 860px; margin: 32px auto; padding: clamp(20px, 4vw, 40px); overflow-wrap: anywhere; }
  nav { display: flex; flex-wrap: wrap; gap: 18px; margin-bottom: 24px; }
  nav a[aria-current="page"] { font-weight: 700; text-decoration: underline; }
  .updated { color: var(--bone-dim); }
  .legal-page :global(h2) { margin-top: 32px; font-size: 1.35rem; }
  .legal-page :global(p), .legal-page :global(li) { line-height: 1.75; }
  .legal-page :global(ul) { padding-left: 24px; }
  .back { margin-top: 40px; }
</style>
