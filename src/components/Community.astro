---
import pkg from '../../package.json';
import {SITE} from '../lib/site';
declare const __MANIFESTO_JS__: {revision:string};
const socialSrc=`/js/community.js?v=${pkg.version}-${__MANIFESTO_JS__.revision}`;
const {profileId='',tab='profile'}=Astro.props;
---
<section id="community" class="community" data-profile={profileId} data-tab={tab} data-site={SITE}>
  <header class="social-heading"><h2 id="social-hello">Olá</h2><button id="social-logout" class="social-logout" type="button" hidden>Sair da conta</button></header>
  <p id="social-status" class="social-status" role="status" aria-live="polite"></p>
  <div class="social-tabs" role="tablist" aria-label="Comunidade">
    <button type="button" role="tab" id="social-tab-profile" aria-controls="social-content" aria-selected={tab === 'profile'} tabindex={tab === 'profile' ? 0 : -1} data-tab="profile">PERFIL</button><button type="button" role="tab" id="social-tab-friends" aria-controls="social-content" aria-selected={tab === 'friends'} tabindex={tab === 'friends' ? 0 : -1} data-tab="friends">AMIGOS</button><button type="button" role="tab" id="social-tab-ranking" aria-controls="social-content" aria-selected={tab === 'ranking'} tabindex={tab === 'ranking' ? 0 : -1} data-tab="ranking">RANKING</button><button type="button" role="tab" id="social-tab-notifications" aria-controls="social-content" aria-selected={tab === 'notifications'} tabindex={tab === 'notifications' ? 0 : -1} data-tab="notifications">CENTRAL <span id="social-unread"></span></button><button type="button" role="tab" id="social-tab-feed" aria-controls="social-content" aria-selected={tab === 'feed'} tabindex={tab === 'feed' ? 0 : -1} data-tab="feed">RESENHA</button><button type="button" role="tab" id="social-tab-settings" aria-controls="social-content" aria-selected={tab === 'settings'} tabindex={tab === 'settings' ? 0 : -1} data-tab="settings">CONFIGURAÇÕES</button>
  </div>
  <div class="social-workspace">
    <details class="social-account-panel" open><summary>SUA CONTA ▾</summary><section id="social-account" aria-label="Sua conta"></section></details>
    <div id="social-content" class="social-content" role="tabpanel" aria-labelledby={`social-tab-${tab}`} aria-busy="true"></div>
  </div>
</section>
<script is:inline type="module" src={socialSrc}></script>
