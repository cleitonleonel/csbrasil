<dialog id="login-prompt" class="login-prompt" aria-modal="true" aria-labelledby="login-prompt-title" aria-describedby="login-prompt-lead">
  <div class="login-prompt-card">
    <header><small>SUA CONTA · CORO SOLTO</small><button id="login-prompt-close" type="button" aria-label="Fechar e jogar sem conta">✕</button></header>
    <h2 id="login-prompt-title">Entre na sua conta</h2>
    <div id="login-prompt-treta" class="login-prompt-treta" hidden>
      <img alt="" width="64" height="64" decoding="async">
      <div>
        <p id="login-prompt-treta-headline"></p>
        <ul id="login-prompt-treta-list"></ul>
        <p id="login-prompt-treta-cap" class="login-prompt-treta-cap"></p>
      </div>
    </div>
    <p id="login-prompt-lead">Seu nick, conquistas e amigos ficam salvos em qualquer aparelho.</p>
    <div id="login-prompt-providers" class="login-prompt-providers"></div>
    <p id="login-prompt-status" class="account-entry-status" role="status" aria-live="polite"></p>
    <button id="login-prompt-guest" class="login-prompt-guest" type="button">Agora não</button>
    <p class="login-prompt-note">É grátis. Sem conta você também joga.</p>
  </div>
</dialog>
